{
  "name": "@amelie-pierce/figma-cli",
  "version": "2.2.5-make.2",
  "description": "Figma Desktop CLI with direct Figma Make source editing and skills for Claude Code, Codex, and Copilot.",
  "author": {
    "name": "Sil Bormüller",
    "url": "https://www.silbormueller.com/"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "figma-ds-cli": "src/index.js",
    "figma-cli": "src/index.js"
  },
  "files": [
    "install.mjs",
    "src",
    "plugin",
    "skills",
    "!src/.figma-client-*.mjs",
    "REFERENCE.md",
    "docs/PORTABILITY.md",
    ".claude-plugin"
  ],
  "keywords": [
    "figma",
    "design-system",
    "design-tokens",
    "cli",
    "variables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amelie-pierce/figma-cli.git"
  },
  "homepage": "https://github.com/amelie-pierce/figma-cli",
  "bugs": {
    "url": "https://github.com/amelie-pierce/figma-cli/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:live": "node tests/live/parity-harness.mjs && node examples/autolayout-patterns.mjs",
    "test:parity": "node tests/live/parity-harness.mjs",
    "examples": "node examples/autolayout-patterns.mjs",
    "postinstall": "node src/install-skills.js",
    "test:make": "node tests/run-make-tests.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "ora": "^8.0.0",
    "pngjs": "^7.0.0",
    "ws": "^8.16.0",
    "yaml": "^2.9.0"
  }
}
